@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #000000;
    color: #ffffff;
  }

  /* Custom minimal luxury scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #000000;
  }
  ::-webkit-scrollbar-thumb {
    background: #282522;
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #d4b59f;
  }
}

/* Custom luxury utilities */
.font-display {
  font-family: 'Cormorant Garamond', 'Playfair Display', serif;
}

.font-serif {
  font-family: 'Playfair Display', Georgia, serif;
}

.font-sans {
  font-family: 'Plus Jakarta Sans', sans-serif;
}

/* Luxury hairline borders */
.border-luxe {
  border-color: rgba(212, 181, 159, 0.16);
}

.border-luxe-hover:hover {
  border-color: rgba(212, 181, 159, 0.4);
}

/* Subtle glassmorphism */
.glass-panel {
  background: rgba(12, 12, 12, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(212, 181, 159, 0.12);
}

.glass-nav {
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(212, 181, 159, 0.15);
}

/* Hardware accelerated transform utility */
.gpu-accel {
  transform: translateZ(0);
  backface-visibility: hidden;
  perspective: 1000px;
}

/* Hide scrollbars for reels scroll container */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* ========================================================= */
/* NEECHE KA THEME: White / Alabaster Luxury Lower Sections */
/* ========================================================= */
.theme-light-sections {
